# your site address, no trailing slash (Netlify fills URL automatically, this overrides it)
SITE_URL=https://lookclub.netlify.app
# a long random password for /admin
ADMIN_KEY=change-me-to-something-long
# from resend.com → API keys
RESEND_API_KEY=re_xxxxxxxx
# who the emails come from (a domain you verified in Resend)
MAIL_FROM=look club <hunt@mail.yourdomain.com>
# where replies go: your Resend receiving address (…@xxxx.resend.app) or an address on your receiving domain
MAIL_REPLY_TO=hunt@xxxx.resend.app
# from the Resend webhook you create for "email.received"
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
